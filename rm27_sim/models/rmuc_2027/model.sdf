<?xml version="1.0"?>
<sdf version="1.9">
  <model name="rmuc_2027">
    <static>true</static>
    <link name="arena">
      <!-- 实体渲染：官方 STP 经 OCCT 三角化，颜色取自 XCAF label 树里的逐面
           颜色（59,685 个面带色，含纯红/纯蓝），按 9 个主色聚类。
           不再使用贴图或 UV；四区后备版本在 model.sdf.bak_fourzone。 -->
      <visual name="arena_black">
        <geometry>
          <mesh>
            <uri>meshes/color_black.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.030 0.030 0.030 1</diffuse>
          <specular>0.030 0.030 0.030 1</specular>
        </material>
      </visual>

