<?xml version="1.0" encoding="UTF-8"?>
<!-- 纯资源容器：仅提供 model://gabel_airframe/meshes/*.stl，不被 world 直接实例化。 -->
<sdf version="1.9">
  <model name="gabel_airframe">
    <static>true</static>
    <link name="link">
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
      </inertial>
    </link>
  </model>
</sdf>
