<?xml version="1.0" encoding="UTF-8"?>
<!-- Drone-Harrier RM hardware visuals use the original Gabel CAD. PX4/X500 SITL flight dynamics and DECXIN sensor geometry are preserved. -->
<sdf version="1.9">
  <model name="drone_harrier">
    <link name="base_link">
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.02166666666666667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02166666666666667</iyy>
          <iyz>0</iyz>
          <izz>0.04000000000000001</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay />
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.0008726646</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
      <!-- Original Gabel facets repartitioned by hardware component; original STL assets kept. -->
      <visual name="gabel_body_visual_orange">
        <geometry>
          <mesh>
            <uri>model://gabel_airframe/meshes/harrier_rm27/body_orange.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.20 0.02 1</ambient>
          <diffuse>1.00 0.42 0.06 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <visual name="gabel_body_visual_red">
        <geometry>
          <mesh>
            <uri>model://gabel_airframe/meshes/harrier_rm27/body_red.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.45 0.04 0.06 1</ambient>
          <diffuse>0.80 0.10 0.14 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <visual name="gabel_body_visual_white">
        <geometry>
          <mesh>
            <uri>model://gabel_airframe/meshes/harrier_rm27/body_white.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.62 0.62 0.62 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>
      <!-- Hardware CAD proxies. These visuals add no mass or new collisions; see hardware.json. -->
      <visual name="micoair_743_v2_aio_35a">
        <geometry>
          <mesh><uri>model://gabel_airframe/meshes/harrier_rm27/flight_controller.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.04 0.21 0.19 1</ambient>
          <diffuse>0.08 0.43 0.38 1</diffuse>
          <specular>0.20 0.25 0.23 1</specular>
        </material>
      </visual>
      <visual name="orange_pi_cm5_rk3588s_4gb_32gb">
        <geometry>
          <mesh><uri>model://gabel_airframe/meshes/harrier_rm27/compute_module.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.10 0.22 0.05 1</ambient>
          <diffuse>0.30 0.53 0.13 1</diffuse>
          <specular>0.24 0.27 0.22 1</specular>
        </material>
      </visual>
      <visual name="tmotor_1204_6500kv_motor_0">
        <geometry>
          <mesh><uri>model://gabel_airframe/meshes/harrier_rm27/motor_0.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.14 0.15 0.17 1</ambient>
          <diffuse>0.28 0.31 0.36 1</diffuse>
          <specular>0.50 0.52 0.55 1</specular>
        </material>
      </visual>
      <visual name="propeller_1816_0">
        <geometry>
          <mesh><uri>model://gabel_airframe/meshes/harrier_rm27/prop_0.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.10 0.13 0.19 1</ambient>
          <diffuse>0.22 0.29 0.43 1</diffuse>
          <specular>0.36 0.37 0.42 1</specular>
        </material>
      </visual>
      <visual name="tmotor_1204_6500kv_motor_1">
        <geometry>
          <mesh><uri>model://gabel_airframe/meshes/harrier_rm27/motor_1.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.14 0.15 0.17 1</ambient>
          <diffuse>0.28 0.31 0.36 1</diffuse>
          <specular>0.50 0.52 0.55 1</specular>
        </material>
      </visual>
      <visual name="propeller_1816_1">
        <geometry>
          <mesh><uri>model://gabel_airframe/meshes/harrier_rm27/prop_1.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.10 0.13 0.19 1</ambient>
          <diffuse>0.22 0.29 0.43 1</diffuse>
          <specular>0.36 0.37 0.42 1</specular>
        </material>
      </visual>
      <visual name="tmotor_1204_6500kv_motor_2">
        <geometry>
          <mesh><uri>model://gabel_airframe/meshes/harrier_rm27/motor_2.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.14 0.15 0.17 1</ambient>
          <diffuse>0.28 0.31 0.36 1</diffuse>
          <specular>0.50 0.52 0.55 1</specular>
        </material>
      </visual>
      <visual name="propeller_1816_2">
        <geometry>
          <mesh><uri>model://gabel_airframe/meshes/harrier_rm27/prop_2.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.10 0.13 0.19 1</ambient>
          <diffuse>0.22 0.29 0.43 1</diffuse>
          <specular>0.36 0.37 0.42 1</specular>
        </material>
      </visual>
      <visual name="tmotor_1204_6500kv_motor_3">
        <geometry>
          <mesh><uri>model://gabel_airframe/meshes/harrier_rm27/motor_3.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.14 0.15 0.17 1</ambient>
          <diffuse>0.28 0.31 0.36 1</diffuse>
          <specular>0.50 0.52 0.55 1</specular>
        </material>
      </visual>
      <visual name="propeller_1816_3">
        <geometry>
          <mesh><uri>model://gabel_airframe/meshes/harrier_rm27/prop_3.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.10 0.13 0.19 1</ambient>
          <diffuse>0.22 0.29 0.43 1</diffuse>
          <specular>0.36 0.37 0.42 1</specular>
        </material>
      </visual>
      <collision name="gabel_body_collision">
        <geometry>
          <mesh>
            <uri>model://gabel_airframe/meshes/gabel_collision.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <!-- OV9281 monochrome down camera. Lens pose and FOV are provisional
           for Gazebo. 120 Hz is a target in simulation time; the renderer
           does not simulate exposure or the optical-message transmitter. -->
      <visual name="ov9281_down_camera_housing">
        <pose>0.026 0 -0.027 0 0 0</pose>
        <geometry><box><size>0.024 0.024 0.009</size></box></geometry>
        <material>
          <ambient>0.04 0.11 0.09 1</ambient>
          <diffuse>0.08 0.24 0.19 1</diffuse>
        </material>
      </visual>
      <visual name="ov9281_down_lens">
        <pose>0.026 0 -0.0325 0 0 0</pose>
        <geometry><cylinder><radius>0.005</radius><length>0.002</length></cylinder></geometry>
        <material>
          <ambient>0.03 0.03 0.04 1</ambient>
          <diffuse>0.06 0.06 0.08 1</diffuse>
        </material>
      </visual>
      <sensor name="ov9281_down" type="camera">
        <gz_frame_id>ov9281_down_optical</gz_frame_id>
        <pose>0.026 0 -0.0336 0 1.5707963267948966 0</pose>
        <always_on>1</always_on>
        <update_rate>120</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.5707963267948966</horizontal_fov>
          <image><width>1280</width><height>800</height><format>L8</format></image>
          <clip><near>0.012</near><far>20</far></clip>
        </camera>
      </sensor>
    </link>
    <link name="rotor_0">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.174 -0.174 0.06 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_1">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.174 0.174 0.06 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_2">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>0.174 0.174 0.06 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name="rotor_3">
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <velocity_decay />
      <pose>-0.174 -0.174 0.06 0 0 0</pose>
      <inertial>
        <mass>0.016076923076923075</mass>
        <inertia>
          <ixx>3.8464910483993325e-07</ixx>
          <iyy>2.6115851691700804e-05</iyy>
          <izz>2.649858234714004e-05</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
