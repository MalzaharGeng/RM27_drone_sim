    </plugin>
    <link name="cam_left_link">
      <pose relative_to="base_link">0.0485 0.025 -0.0057 0 0 0</pose>
      <inertial>
        <mass>0.010</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry>
          <box>
            <size>0.02 0.02 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <sensor name="cam_left" type="camera">
        <gz_frame_id>cam_left_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.590</horizontal_fov>
          <image>
            <width>960</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.003</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <link name="cam_right_link">
      <pose relative_to="base_link">0.0485 -0.025 -0.0057 0 0 0</pose>
      <inertial>
        <mass>0.010</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry>
          <box>
            <size>0.02 0.02 0.025</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <sensor name="cam_right" type="camera">
        <gz_frame_id>cam_right_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.590</horizontal_fov>
          <image>
            <width>960</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.003</stddev>
          </noise>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="cam_left_joint" type="fixed">
      <parent>base_link</parent>
      <child>cam_left_link</child>
    </joint>
    <joint name="cam_right_joint" type="fixed">
      <parent>base_link</parent>
      <child>cam_right_link</child>
    </joint>
  </model>
</sdf>
