<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rm27_world">
    <!-- 渲染传感器（相机/深度）必须由 Sensors 系统驱动，否则 model 里的
         <sensor type="camera"> 只有组件、没有图像发布者。默认 server.config
         只加载 Physics / UserCommands / SceneBroadcaster 三个系统。 -->
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>


    <physics name="default_physics" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.2 0.2 0.2 1</background>
      <!-- 阴影关闭：本机 WSL 的 OpenGL 走 D3D12 直通（RTX 5070 Ti，非 llvmpipe），
           但开 GUI 后主循环与渲染同步，RTF 仍会下降，图像时间戳随之抖动、
           ORB-SLAM3 地图反复重建（实测开阴影 maps=46/ev=1 仅 2；关后 maps=24/ev=1=48）。
           阴影对 ORB 特征没有贡献（地面是平面），关掉只影响观感。 -->
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <direction>-0.3 0.2 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- 场地视觉由文件末尾的 model://rmuc_2027 include 提供 -->

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <model name="arena_ground">
      <static>true</static>
      <pose>0 0 0.019 0 0 0</pose>
      <link name="link">
        <collision name="ground">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="arena_walls">
      <static>true</static>
      <link name="link">
        <collision name="west">
          <pose>0.249 8.065 1.918 0 0 0</pose>
          <geometry><box><size>0.2 16.0 3.8</size></box></geometry>
        </collision>
        <collision name="east">
          <pose>28.049 8.065 1.918 0 0 0</pose>
          <geometry><box><size>0.2 16.0 3.8</size></box></geometry>
        </collision>
        <collision name="south">
          <pose>14.149 0.164 1.918 0 0 0</pose>
          <geometry><box><size>28.0 0.2 3.8</size></box></geometry>
        </collision>
        <collision name="north">
          <pose>14.149 15.967 1.918 0 0 0</pose>
          <geometry><box><size>28.0 0.2 3.8</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- The arena mesh has no collision, so its raised base platform near the
         far (enemy) base is invisible to physics. This pad matches the visible
         platform top (z=0.318) under base_far_front, so the drone lands on it
         instead of sinking through the visual floor. -->
    <model name="base_landing_pad">
      <static>true</static>
      <pose>24.7 8.0 0.169 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 2.0 0.3</size></box></geometry>
        </collision>
      </link>
    </model>

  
      <!-- 场地视觉：model://rmuc_2027 内是官方 STP 转出的四块纯色网格，
           不再使用贴图或 UV。碰撞仍由上面的 arena_ground / arena_walls 提供。 -->
    <include>
      <uri>model://rmuc_2027</uri>
      <name>rmuc_2027</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <!-- Visual texture decals for ORB-SLAM3 feature extraction.
         Purely visual (no collision), does NOT modify rmuc_2027 or any
         existing model/geometry. Delete this whole block to revert;
         backup: rm27_world.sdf.bak_before_texture_20261111 -->
    <include>
      <uri>model://arena_texture_patches</uri>
      <name>arena_texture_patches</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Landing-gear contact pad: COLLISION ONLY, no visual.
         The visible arena floor along the launch/landing corridor is z~0.265,
         but arena_ground's collision plane is z=0.019, so the gear used to
         sink ~0.25 m into the floor. This raises the physical contact surface
         to the visible floor without changing any mesh or appearance.
         Delete this block to revert; backup: *.bak_before_ground_fix_20261111 -->
    <model name="launch_ground_pad">
      <static>true</static>
      <pose>7.5 6.0 0.13 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9.0 6.0 0.27</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>

