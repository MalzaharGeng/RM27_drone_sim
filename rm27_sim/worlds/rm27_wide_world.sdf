<?xml version="1.0"?>
<!-- [NP-01 FIX17] Wide-clearance baseline. Independent world: the original
     rm27_world (arena, spawn and textures) is NOT touched or included.
     Geometry is generated by make_wide_world.py and fixed before any run. -->
<sdf version="1.9">
  <world name="rm27_wide_world">
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="default_physics" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.2 0.2 0.2 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <direction>-0.3 0.2 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Physical ground: same top height as the original arena_ground (0.019). -->
    <model name="wide_ground">
      <static>true</static>
      <pose>0 0 0.019 0 0 0</pose>
      <link name="link">
        <collision name="ground">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-62.100 0.000 1.900 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.200 124.400 3.800</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.200 124.400 3.800</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.68 0.68 0.68 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>62.100 0.000 1.900 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.200 124.400 3.800</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.200 124.400 3.800</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.68 0.68 0.68 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0.000 -62.100 1.900 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>124.400 0.200 3.800</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>124.400 0.200 3.800</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.68 0.68 0.68 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0.000 62.100 1.900 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>124.400 0.200 3.800</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>124.400 0.200 3.800</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.68 0.68 0.68 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://rm27_wide_floor</uri>
      <name>rm27_wide_floor</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
